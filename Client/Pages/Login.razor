@page "/login"
@layout LoginLayout
@inject HttpClient Http
@inject SSTAuthStateProvider Auth
@inject NavigationManager Nav
@attribute [AllowAnonymous]

<PageTitle>Iniciar sesión · SST-Digital RD</PageTitle>

<div class="login-wrap">
    <div class="login-card">

        <!-- Logo / Marca -->
        <div class="login-brand">
            <div class="login-logo">
                 <i class="ti ti-shield-check" aria-hidden="true"></i>                 
            </div>
            <div>
                <div class="login-title">SST-Digital RD</div>
                <div class="login-subtitle">
                    Sistema de Seguridad y Salud en el Trabajo
                </div>
            </div>
        </div>

        @if (!Paso2FA)
        {
            <!-- Paso 1: credenciales -->
            <div class="form-field" style="margin-bottom:12px">
                <label>Correo electrónico</label>
                <input type="email"
                       @bind="Correo"
                       @bind:event="oninput"
                       @onkeydown="OnKeyDown"
                       placeholder="usuario@empresa.do"
                       autocomplete="email" />
            </div>

            <div class="form-field" style="margin-bottom:20px">
                <label>Contraseña</label>
                <input type="password"
                       @bind="Password"
                       @bind:event="oninput"
                       @onkeydown="OnKeyDown"
                       placeholder="••••••••"
                       autocomplete="current-password" />
            </div>

        

            <div style="display:flex;align-items:flex-start;gap:8px;
                margin-bottom:16px;font-size:12px;
                color:var(--text-sec)">
                <input type="checkbox"
                       @bind="AceptoPolitica"
                       id="politica"
                       style="margin-top:2px;flex-shrink:0" />
                <label for="politica">
                    He leído y acepto la
                    <a href="/privacidad" target="_blank"
                       style="color:var(--color-text-info)">
                        Política de Privacidad
                    </a>
                    de SST-Digital RD
                </label>
            </div>

            @if (!string.IsNullOrEmpty(Error))
            {
                        <div class="alert-banner error" style="margin-bottom:12px">
                            <i class="ti ti-alert-circle" aria-hidden="true"></i>
                            <span>@Error</span>
                        </div>
            }

            <button class="btn-primary"
                    style="width:100%;justify-content:center;height:40px"
                    @onclick="IniciarSesion"
                    disabled="@Cargando">
                @if (Cargando)
                {
                    <i class="ti ti-loader-2 spin" aria-hidden="true"></i>
                    <span>Verificando...</span>
                }
                else
                {
                    <i class="ti ti-login" aria-hidden="true"></i>
                    <span>Iniciar sesión</span>
                }
            </button>
        }
        else
        {
            <!-- Paso 2: código 2FA -->
            <div style="text-align:center;margin-bottom:20px">
                <i class="ti ti-mail-check"
                   style="font-size:32px;color:var(--color-text-info)"
                   aria-hidden="true"></i>
                <div style="font-size:13px;font-weight:500;
                                color:var(--text-primary);margin-top:8px">
                    Código enviado a tu correo
                </div>
                <div style="font-size:12px;color:var(--text-hint);
                                margin-top:4px">
                    Ingresa el código de 6 dígitos que enviamos a
                    <strong>@Correo</strong>.
                    Expira en 10 minutos.
                </div>
            </div>

            <div class="form-field" style="margin-bottom:16px">
                <label>Código de verificación</label>
                <input type="text"
                       @bind="Codigo2FA"
                       @bind:event="oninput"
                       @onkeydown="OnKeyDown2FA"
                       placeholder="123456"
                       maxlength="6"
                       style="letter-spacing:0.3em;
                                  font-size:20px;text-align:center"
                       autocomplete="one-time-code" />
            </div>

            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="alert-banner error" style="margin-bottom:12px">
                    <i class="ti ti-alert-circle" aria-hidden="true"></i>
                    <span>@Error</span>
                </div>
            }

            <button class="btn-primary"
                    style="width:100%;justify-content:center;height:40px"
                    @onclick="Verificar2FA"
                    disabled="@Cargando">
                @if (Cargando)
                {
                    <i class="ti ti-loader-2 spin" aria-hidden="true"></i>
                    <span>Verificando...</span>
                }
                else
                {
                    <i class="ti ti-shield-check" aria-hidden="true"></i>
                    <span>Verificar código</span>
                }
            </button>

            <button style="width:100%;margin-top:8px;background:none;
                               border:none;font-size:12px;cursor:pointer;
                               color:var(--text-hint)"
                    @onclick="VolverAlLogin">
                ← Volver al inicio de sesión
            </button>
        }

        <div style="text-align:center;margin-top:16px;
                    font-size:11px;color:var(--text-hint)">
            SST-Digital RD · UNIBE 2026 · v1.0
        </div>
    </div>
</div>

@code {
    private string Correo = "";
    private string Password = "";
    private string Error = "";    
    private string Codigo2FA = "";
    private bool Cargando = false;
    private bool AceptoPolitica = false;
    private bool Paso2FA = false;    


    private async Task IniciarSesion()
    {
        if (string.IsNullOrWhiteSpace(Correo) || string.IsNullOrWhiteSpace(Password))
        {
            Error = "Por favor ingresa tu correo y contraseña.";
            return;
        }

        if (!AceptoPolitica)
        {
            Error = "Debes aceptar la Política de Privacidad para continuar.";
            return;
        }


        Cargando = true;
        Error = "";
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", new { Correo, Password });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SSTDigitalRD.Shared.DTOs.LoginResponseDto>();

                if (result?.Requiere2FA == true)
                {
                    Paso2FA = true; // mostrar paso 2
                }

                // if (result is not null)
                // {
                //     await Auth.Login(result);
                //     Nav.NavigateTo("/");
                // }
            }
            else
            {
                Error = "Correo o contraseña incorrectos.";
            }
        }
        catch
        {
            Error = "Error de conexión. Intenta de nuevo.";
        }
        finally
        {
            Cargando = false;
            StateHasChanged();
        }
    }

    private async Task Verificar2FA()
    {
        if (string.IsNullOrWhiteSpace(Codigo2FA) || Codigo2FA.Length != 6)
        {
            Error = "Ingresa el código de 6 dígitos.";
            return;
        }

        Cargando = true;
        Error = "";
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/verificar-2fa", new { Correo, Codigo = Codigo2FA });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponseDto>();

                if (result is not null)
                {
                    await Auth.Login(result);
                    Nav.NavigateTo("/");
                }
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorResponseDto>();
                Error = err?.Error ?? "Código incorrecto.";
            }
        }
        catch
        {
            Error = "Error de conexión. Intenta de nuevo.";
        }
        finally
        {
            Cargando = false;
            StateHasChanged();
        }
    }

    private void VolverAlLogin()
    {
        Paso2FA = false;
        Codigo2FA = "";
        Error = "";
    }

    private async Task OnKeyDown2FA(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Verificar2FA();
    }


    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await IniciarSesion();
    }

    private class ErrorResponseDto
    {
        public string Error { get; set; } = "";
    }
}